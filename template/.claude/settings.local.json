{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(gamekit *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(dotnet *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(open *)",
      "Bash(start *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(unzip *)",
      "Bash(tar *)",
      "Skill(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(* | bash)",
      "Bash(* | sh)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(* --no-preserve-root *)",
      "Bash(* > /dev/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_TOOL_ARG_FILE_PATH\" == *.cs ]]; then echo '[C#] File written - verify-changes: Wait for recompile, check for errors.'; fi"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_TOOL_ARG_FILE_PATH\" == *.cs ]]; then echo '[C#] File edited - verify-changes: Wait for recompile, check for errors.'; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[REMINDERS] (1) scene-awareness: Capture state before major changes (2) verify-changes: Test after modifications (3) quality-gate: Run before saying done (4) Document blockers to LEARNINGS.md'"
          }
        ]
      }
    ]
  }
}
